rules_version = '2';

// Guess My Drawing has no user auth (players are an anonymous id kept in
// localStorage), so these rules can't gate on request.auth. Instead they:
//   1. expose ONLY the /rooms tree — the rest of the database is denied
//   2. shape-check and size-cap every write so a random client can't dump
//      arbitrary documents or oversized blobs into the project
// Good enough for a public demo; add Firebase Auth + per-player checks before
// trusting this with anything real.

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny. Anything not matched by a rule below is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }

    match /rooms/{code} {
      allow read: if true;
      allow create: if isValidRoom()
                    && request.resource.data.code == code
                    && request.resource.data.createdAt == request.time;
      allow update: if isValidRoom();
      // A public demo room holds nothing precious; let anyone clear a finished
      // one. Tighten this (or drop it) once rooms matter.
      allow delete: if true;

      function isValidRoom() {
        let d = request.resource.data;
        return d.size() <= 20
          && d.code is string && d.code.size() <= 12
          && d.status in ['lobby', 'playing', 'round-end', 'game-over']
          && d.players is list && d.players.size() <= 16
          && d.roundNumber is number
          && d.totalRounds is number
          && (!('hostId' in d) || (d.hostId is string && d.hostId.size() <= 128))
          && (!('currentDrawerId' in d) || d.currentDrawerId == null
              || (d.currentDrawerId is string && d.currentDrawerId.size() <= 128))
          && (!('currentWord' in d) || d.currentWord == null
              || (d.currentWord is string && d.currentWord.size() <= 40));
      }

      match /strokes/{point} {
        allow read: if true;
        allow create: if isValidStroke();
        allow update: if false;
        // The drawer / host clears the previous round's strokes each round.
        allow delete: if true;

        function isValidStroke() {
          let d = request.resource.data;
          return d.size() <= 8
            && d.round is number
            && d.s is number
            && d.seq is number
            && d.t is number
            && d.x is number && d.x >= -5 && d.x <= 5
            && d.y is number && d.y >= -5 && d.y <= 5;
        }
      }

      match /guesses/{guess} {
        allow read: if true;
        allow create: if isValidGuess();
        allow update, delete: if false;

        function isValidGuess() {
          let d = request.resource.data;
          return d.size() <= 8
            && d.playerId is string && d.playerId.size() <= 128
            && d.name is string && d.name.size() <= 40
            && d.text is string && d.text.size() <= 200
            && d.round is number
            && d.correct is bool
            && d.createdAt == request.time;
        }
      }
    }
  }
}
